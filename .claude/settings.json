{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "substrate-engine hook protect-paths"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "substrate-engine hook protect-command"
          },
          {
            "type": "command",
            "command": "substrate-engine hook enforce-jj"
          },
          {
            "type": "command",
            "command": "substrate-engine hook enforce-conventional-commits"
          },
          {
            "type": "command",
            "command": "substrate-engine hook gate-before-push"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|Task",
        "hooks": [
          {
            "type": "command",
            "command": "substrate-engine hook agent-lifecycle observe"
          },
          {
            "type": "command",
            "command": "substrate-engine hook changed-files-scan"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "substrate-engine hook agent-lifecycle start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "substrate-engine hook agent-lifecycle stop"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "substrate-engine hook agent-lifecycle end"
          }
        ]
      }
    ]
  }
}
