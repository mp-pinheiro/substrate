{
  "name": "base",
  "claims": {
    ".yml": { "mode": "line", "markers": ["#"] },
    ".yaml": { "mode": "line", "markers": ["#"] },
    ".json": { "mode": "exempt" }
  },
  "toolchain": [
    { "bin": "actionlint", "hint": "https://github.com/rhysd/actionlint (single static binary)" }
  ],
  "ci": [
    "curl -sSfL -o /tmp/actionlint.tar.gz \"https://github.com/rhysd/actionlint/releases/download/v1.7.12/actionlint_1.7.12_linux_$([ \"$(uname -m)\" = aarch64 ] && echo arm64 || echo amd64).tar.gz\"",
    "printf '%s  /tmp/actionlint.tar.gz\\n' \"$([ \"$(uname -m)\" = aarch64 ] && echo 325e971b6ba9bfa504672e29be93c24981eeb1c07576d730e9f7c8805afff0c6 || echo 8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8)\" | sha256sum -c -",
    "sudo tar -xzf /tmp/actionlint.tar.gz -C /usr/local/bin actionlint"
  ],
  "templates": [],
  "checks": ["59-actionlint.sh"],
  "slop_fixtures": ["fixtures/slop.yml"],
  "check_fixtures": [
    { "file": "fixtures/bad.json", "fails": "40-data-validity.sh" },
    { "file": "fixtures/bad-workflow.yml", "fails": "59-actionlint.sh", "dest": ".github/workflows/substrate-matrix-bad.yml" },
    { "file": "fixtures/bad-plan.md", "fails": "15-tracking.sh", "dest": ".pi/plans/substrate-matrix-bad.md" },
    { "file": "fixtures/bad-superseded.md", "fails": "15-tracking.sh", "dest": ".pi/plans/substrate-matrix-bad2.md" },
    { "file": "fixtures/bad-committed-empty.md", "fails": "15-tracking.sh", "dest": ".pi/plans/substrate-matrix-bad3.md" }
  ],
  "lsp": {
    "yamlls": { "bin": "yaml-language-server", "hint": "bun install -g yaml-language-server" },
    "vscode-json-language-server": { "bin": "vscode-json-language-server", "hint": "bun install -g vscode-langservers-extracted" }
  }
}
