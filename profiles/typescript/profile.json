{
  "name": "typescript",
  "claims": {
    ".ts": { "mode": "ast", "ast_lang": "typescript", "markers": ["//"], "block": [["/*", "*/"]] },
    ".tsx": { "mode": "ast", "ast_lang": "tsx", "markers": ["//"], "block": [["/*", "*/"]] },
    ".js": { "mode": "ast", "ast_lang": "javascript", "markers": ["//"], "block": [["/*", "*/"]] },
    ".jsx": { "mode": "ast", "ast_lang": "javascript", "markers": ["//"], "block": [["/*", "*/"]] },
    ".mjs": { "mode": "ast", "ast_lang": "javascript", "markers": ["//"], "block": [["/*", "*/"]] },
    ".cjs": { "mode": "ast", "ast_lang": "javascript", "markers": ["//"], "block": [["/*", "*/"]] }
  },
  "toolchain": [
    { "bin": "bun", "hint": "https://bun.sh" },
    { "bin": "depcruise", "hint": "bun install -g dependency-cruiser@18" }
  ],
  "ci": ["bun install -g dependency-cruiser@18"],
  "templates": [
    { "src": "tsconfig.json", "dest": "tsconfig.json" },
    { "src": "dependency-cruiser.cjs", "dest": ".dependency-cruiser.cjs" }
  ],
  "checks": ["71-tsc.sh", "72-depcruise.sh", "74-constructs.sh"],
  "slop_fixtures": ["fixtures/slop.ts"],
  "check_fixtures": [
    { "file": "fixtures/bad-tsc.ts", "fails": "71-tsc.sh" },
    { "file": "fixtures/bad-cycle", "fails": "72-depcruise.sh" },
    { "file": "fixtures/bad-constructs.ts", "fails": "74-constructs.sh" }
  ],
  "lsp": {
    "typescript-language-server": { "bin": "typescript-language-server", "hint": "bun install -g typescript-language-server typescript" }
  }
}
