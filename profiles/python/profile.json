{
  "name": "python",
  "claims": {
    ".py": { "mode": "ast", "ast_lang": "python", "markers": ["#"] }
  },
  "shebang": [
    { "interpreters": ["python", "python3"], "as": ".py" }
  ],
  "toolchain": [
    { "bin": "ruff", "hint": "https://docs.astral.sh/ruff/installation/" },
    { "bin": "python3", "hint": "https://www.python.org/downloads/" },
    { "bin": "lint-imports", "hint": "pipx install import-linter" },
    { "bin": "vulture", "hint": "pipx install vulture" }
  ],
  "ci": [
    "sudo apt-get update -qq",
    "sudo apt-get install -y -qq python3 python3-pip pipx",
    "sudo PIPX_HOME=/opt/pipx PIPX_BIN_DIR=/usr/local/bin pipx install ruff==0.16.1",
    "sudo PIPX_HOME=/opt/pipx PIPX_BIN_DIR=/usr/local/bin pipx install import-linter==2.13",
    "sudo PIPX_HOME=/opt/pipx PIPX_BIN_DIR=/usr/local/bin pipx install vulture==2.16"
  ],
  "templates": [
    { "src": "ruff.toml", "dest": "ruff.toml" },
    { "src": "importlinter", "dest": ".importlinter" }
  ],
  "checks": ["60-ruff.sh", "61-py-syntax.sh", "62-import-linter.sh", "63-vulture.sh", "64-constructs.sh"],
  "slop_fixtures": ["fixtures/slop.py", "fixtures/slop-py-noext"],
  "check_fixtures": [
    { "file": "fixtures/bad-ruff.py", "fails": "60-ruff.sh" },
    { "file": "fixtures/bad-syntax.py", "fails": "61-py-syntax.sh" },
    { "file": "fixtures/bad-vulture.py", "fails": "63-vulture.sh" },
    { "file": "fixtures/bad-constructs.py", "fails": "64-constructs.sh" },
    { "file": "fixtures/bad-imports", "fails": "62-import-linter.sh", "dest": "." }
  ],
  "lsp": {
    "ruff": { "bin": "ruff", "hint": "pipx install ruff (or: uv tool install ruff)" }
  }
}
