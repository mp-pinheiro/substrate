{
  "name": "python",
  "claims": {
    ".py": { "mode": "ast", "ast_lang": "python", "markers": ["#"] }
  },
  "shebang": [
    { "interpreters": ["python", "python3"], "as": ".py" }
  ],
  "toolchain": [
    { "bin": "ruff", "hint": "https://docs.astral.sh/ruff/installation/" },
    { "bin": "python3", "hint": "https://www.python.org/downloads/" }
  ],
  "ci": [
    "sudo apt-get update -qq",
    "sudo apt-get install -y -qq python3 python3-pip pipx",
    "sudo PIPX_HOME=/opt/pipx PIPX_BIN_DIR=/usr/local/bin pipx install ruff"
  ],
  "templates": [{ "src": "ruff.toml", "dest": "ruff.toml" }],
  "checks": ["60-ruff.sh", "61-py-syntax.sh"],
  "slop_fixtures": ["fixtures/slop.py", "fixtures/slop-py-noext"],
  "check_fixtures": [
    { "file": "fixtures/bad-ruff.py", "fails": "60-ruff.sh" },
    { "file": "fixtures/bad-syntax.py", "fails": "61-py-syntax.sh" }
  ]
}
