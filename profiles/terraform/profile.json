{
  "name": "terraform",
  "claims": {
    ".tf": { "mode": "line", "markers": ["#", "//"], "block": [["/*", "*/"]], "heredoc": true },
    ".tfvars": { "mode": "line", "markers": ["#"], "heredoc": true },
    ".hcl": { "mode": "line", "markers": ["#", "//"], "block": [["/*", "*/"]], "heredoc": true }
  },
  "toolchain": [
    { "bin": "terraform", "hint": "https://developer.hashicorp.com/terraform/install" },
    { "bin": "tflint", "hint": "https://github.com/terraform-linters/tflint#installation" }
  ],
  "ci": [
    "curl -sSfLo /tmp/terraform.zip \"https://releases.hashicorp.com/terraform/1.9.8/terraform_1.9.8_linux_$([ \"$(uname -m)\" = aarch64 ] && echo arm64 || echo amd64).zip\"",
    "printf '%s  /tmp/terraform.zip\\n' \"$([ \"$(uname -m)\" = aarch64 ] && echo f85868798834558239f6148834884008f2722548f84034c9b0f62934b2d73ebb || echo 186e0145f5e5f2eb97cbd785bc78f21bae4ef15119349f6ad4fa535b83b10df8)\" | sha256sum -c -",
    "sudo unzip -oq /tmp/terraform.zip terraform -d /usr/local/bin",
    "curl -sSfLo /tmp/tflint.zip \"https://github.com/terraform-linters/tflint/releases/download/v0.64.0/tflint_linux_$([ \"$(uname -m)\" = aarch64 ] && echo arm64 || echo amd64).zip\"",
    "printf '%s  /tmp/tflint.zip\\n' \"$([ \"$(uname -m)\" = aarch64 ] && echo 560da89aacf59389d4eb029730dd5b109b7288096c32f2726a0d9e783a5ea8eb || echo cca9d13e2e1d7a2c627af60ff899a3c9b74212899416aeb96ec764d2ef954537)\" | sha256sum -c -",
    "sudo unzip -oq /tmp/tflint.zip tflint -d /usr/local/bin"
  ],
  "templates": [{ "src": "tflint.hcl", "dest": ".tflint.hcl" }],
  "checks": ["68-terraform-fmt.sh", "69-tflint.sh", "70-terraform-validate.sh"],
  "slop_fixtures": ["fixtures/slop.tf"],
  "check_fixtures": [
    { "file": "fixtures/bad-fmt.tf", "fails": "68-terraform-fmt.sh" },
    { "file": "fixtures/bad-tflint.tf", "fails": "69-tflint.sh" },
    { "file": "fixtures/bad-validate.tf", "fails": "70-terraform-validate.sh" }
  ],
  "lsp": {
    "terraformls": { "bin": "terraform-ls", "hint": "install terraform-ls via your package manager" }
  }
}
