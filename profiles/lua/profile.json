{
  "name": "lua",
  "claims": {
    ".lua": { "mode": "ast", "ast_lang": "lua", "markers": ["--"] },
    ".luacheckrc": { "mode": "line", "markers": ["--"] }
  },
  "toolchain": [
    { "bin": "luacheck", "hint": "https://github.com/lunarmodules/luacheck#installation (apt: lua-check)" },
    { "bin": "stylua", "hint": "prebuilt binary — https://github.com/JohnnyMorganz/StyLua/releases" }
  ],
  "ci": [
    "sudo apt-get update -qq",
    "sudo apt-get install -y -qq lua-check unzip",
    "curl -sSfL -o /tmp/stylua.zip \"https://github.com/JohnnyMorganz/StyLua/releases/download/v2.5.2/stylua-linux-$([ \"$(uname -m)\" = aarch64 ] && echo aarch64 || echo x86_64).zip\"",
    "printf '%s  /tmp/stylua.zip\\n' \"$([ \"$(uname -m)\" = aarch64 ] && echo 0ef2ebf0b7e5a652b65c4cb96c6d9ffb3981a98547de3c764465bbf54a8d761a || echo bcb0d855e91f102f28a370e850f8566b3b44b79e6274d806ea5246837c0fd5ab)\" | sha256sum -c -",
    "sudo unzip -o -q /tmp/stylua.zip -d /usr/local/bin",
    "sudo chmod +x /usr/local/bin/stylua"
  ],
  "templates": [
    { "src": "luacheckrc", "dest": ".luacheckrc" },
    { "src": "stylua.toml", "dest": ".stylua.toml" }
  ],
  "checks": ["77-stylua.sh", "78-luacheck.sh"],
  "slop_fixtures": ["fixtures/slop.lua"],
  "check_fixtures": [
    { "file": "fixtures/bad-luacheck.lua", "fails": "78-luacheck.sh" },
    { "file": "fixtures/bad-stylua.lua", "fails": "77-stylua.sh" }
  ],
  "lsp": {
    "lua-language-server": { "bin": "lua-language-server", "hint": "install lua-language-server via your package manager" }
  }
}
