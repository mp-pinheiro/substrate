#!/usr/bin/env bash
# substrate — deterministic gates for agentic development, installable in any repo.
# Commands: bootstrap, init, gate, checkpoint, baseline, doctor, verify, update, selftest, audit, report.
set -uo pipefail

SCRIPT=$(readlink -f "${BASH_SOURCE[0]}") || { printf 'substrate: cannot resolve executable path\n' >&2; exit 2; }
KIT_ROOT="$(cd "$(dirname "$SCRIPT")/.." && pwd)"

info()    { printf '\033[0;34m[+]\033[0m %s\n' "$*"; }
success() { printf '\033[0;32m[ok]\033[0m %s\n' "$*"; }
warn()    { printf '\033[0;33m[!]\033[0m %s\n' "$*"; }
die()     { warn "$*"; exit 2; }

usage() {
    cat <<'EOF'
usage: substrate <command> [args]

  bootstrap [--profile a,b] [--force] [--from-worktree]  kickstart or synchronize the current repo
  init --profile a,b [--vcs auto|git|jj] [--from-worktree]  install the gate into a new repo
  gate [--update-baseline|--tighten|--accept-regression] | gate --deep [--no-cache|--print-key]
  baseline [--update|--accept-regression[=key1,key2] --reason <text>]
  checkpoint --message <message> --path <path>... [--accept-regression=<metric>[,<metric>] --reason <text>]  gate, tighten, commit locally
  restructure --op split|describe|squash --revision <rev> --message <m> ...  reshape agent commits
  doctor                                    config, langmap freshness, toolchain
  verify                                    active OMP runtime + bounded local gate
  update [--apply] [--force] [--from-worktree]  inspect or re-vendor the engine only
  engine pin [--bin PATH]                    RELEASE ACTION: pin .substrate/engine.json to a built binary (not for dev rebuilds)
  maintenance flags: --checkpoint [--message <message>] [--accept-baseline] [--repo-only] [--json]
                     [--accept-regression=<metric>[,<metric>] --reason <text>]  move a ratcheted metric that a core change moved
                     --from-worktree on bootstrap/init/update vendors from the kit worktree even when
                     it is dirty or unpushed
  selftest                                  sandboxed negative-test battery
  audit [plan.md ...]                       execute plan acceptance oracles
  report [--write|--refresh]                advisory maintenance queue (always exits 0)
EOF
    exit 2
}

profile_dir() {
    local p="$1"
    if [ -d "substrate-profiles/$p" ]; then
        printf '%s\n' "substrate-profiles/$p"
    elif [ -d "$KIT_ROOT/profiles/$p" ]; then
        printf '%s\n' "$KIT_ROOT/profiles/$p"
    else
        return 1
    fi
}

# shellcheck source=../core/install-lib.sh
source "$KIT_ROOT/core/install-lib.sh"
# shellcheck source=../core/doctor.sh
source "$KIT_ROOT/core/doctor.sh"
# shellcheck source=../core/verify.sh
source "$KIT_ROOT/core/verify.sh"
# shellcheck source=../core/maintenance.sh
source "$KIT_ROOT/core/maintenance.sh"


build_langmap() {
    local out="$1"; shift
    local pjsons=() p d
    for p in "$@"; do
        d=$(profile_dir "$p") || die "unknown profile: $p (kit profiles: $(basename -a "$KIT_ROOT"/profiles/* | tr '\n' ' '))"
        jq -e . "$d/profile.json" >/dev/null 2>&1 || die "corrupt profile.json for $p"
        pjsons+=("$d/profile.json")
    done
    jq -s 'reduce .[] as $p ({};
        (reduce ($p.claims | to_entries[]) as $e (.;
            if has($e.key) then error("duplicate claim \($e.key): profiles \(.[$e.key].profile) and \($p.name)")
            else .[$e.key] = ($e.value + {profile: $p.name}) end))
        | .__shebang__ = ((.__shebang__ // []) + [($p.shebang // [])[]
            | {match: .interpreters, entry: ($p.claims[.as] + {profile: $p.name})}]))' \
        "${pjsons[@]}" > "$out" \
        || die "langmap build failed (duplicate claims or corrupt profile.json)"
}

vendor_core() {
    local profiles=("$@") p d c staging backup=""
    repo_path_safe .substrate ".substrate vendor directory" || die "unsafe .substrate destination"
    [ ! -e .substrate ] || [ -d .substrate ] || die ".substrate exists but is not a directory"
    staging=$(mktemp -d .substrate.new.XXXXXX) || die "vendor staging failed"
    mkdir -p "$staging/checks.d" "$staging/profiles"
    cp "$KIT_ROOT"/core/engine-shim.sh \
       "$KIT_ROOT"/core/gate-lib.sh \
       "$KIT_ROOT"/core/check-comments.sh \
       "$KIT_ROOT"/core/selftest.sh "$KIT_ROOT"/core/audit.sh \
       "$KIT_ROOT"/core/report.sh "$KIT_ROOT"/core/gated-push.sh \
       "$KIT_ROOT"/core/push-gate.sh \
       "$KIT_ROOT"/core/maintenance.sh \
       "$KIT_ROOT"/core/checkpoint.sh "$KIT_ROOT"/core/restructure.sh \
       "$KIT_ROOT"/core/receipt-lib.sh \
       "$KIT_ROOT"/core/gitleaks-lib.sh "$KIT_ROOT"/core/gitleaks-deep.sh \
       "$KIT_ROOT"/core/install-gitleaks.sh "$KIT_ROOT"/core/install-jj.sh "$staging/" \
       || die "vendor copy failed: core scripts"
    cp "$KIT_ROOT"/core/checks.d/*.sh "$staging/checks.d/" || die "vendor copy failed: core checks"
    cp "$KIT_ROOT"/VERSION "$staging/VERSION" || die "vendor copy failed: VERSION"
    write_vendor_provenance "$staging" || die "vendor copy failed: vendor.json"
    [ ! -f "$KIT_ROOT/engine.json" ] || cp "$KIT_ROOT"/engine.json "$staging/engine.json" || die "vendor copy failed: engine.json"
    for p in "${profiles[@]}"; do
        d=$(profile_dir "$p") || die "unknown profile: $p"
        cp -R "$d" "$staging/profiles/$p" || die "vendor copy failed: profile $p"
        if [ -d "$d/checks.d" ]; then
            for c in "$d"/checks.d/*.sh; do
                [ -f "$c" ] && { cp "$c" "$staging/checks.d/" || die "vendor copy failed: $c"; }
            done
        fi
    done
    if [ -d checks.d ]; then
        for c in checks.d/*.sh; do
            [ -f "$c" ] && { cp "$c" "$staging/checks.d/" || die "vendor copy failed: repo-local $c"; }
        done
    fi
    build_langmap "$staging/langmap.json" "${profiles[@]}"
    chmod +x "$staging"/*.sh "$staging"/checks.d/*.sh
    if [ -d .substrate ]; then
        backup=$(mktemp -d .substrate.backup.XXXXXX) || die "vendor backup failed"
        rm -rf "$backup"
        mv .substrate "$backup" || die "vendor swap failed: could not set aside old copy"
    fi
    if ! mv "$staging" .substrate; then
        if [ -n "$backup" ] && ! mv "$backup" .substrate 2>/dev/null; then
            die "vendor swap and restore failed — recover the previous copy from $backup"
        fi
        die "vendor swap failed — previous copy restored"
    fi
    [ -z "$backup" ] || rm -rf "$backup"
}



install_repo_scaffold() {
    local force="$1"
    shift
    local profiles=("$@") rc=0
    vendor_core "${profiles[@]}"
    install_templates "${profiles[@]}" || rc=1
    install_ci "$force" "${profiles[@]}" || rc=1
    install_hooks_config || rc=1
    migrate_repo_omp_extension || rc=1
    install_lsp_config "${profiles[@]}" || rc=1
    install_harness_assets || rc=1
    install_recipe || rc=1
    install_jj_workflow_doc || rc=1
    return "$rc"
}

sync_repo_runtime() {
    local rc=0
    install_vcs_hooks || rc=1
    wire_jj_runtime || rc=1
    return "$rc"
}

sync_user_harness() {
    install_user_harness
}

cmd_init_apply() {
    local profiles_csv="" force=0 from_worktree=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --profile)
                [ $# -ge 2 ] || die "--profile needs a comma-separated value"
                profiles_csv="$2"
                shift 2
                ;;
            --vcs)
                [ $# -ge 2 ] || die "--vcs needs auto, git, or jj"
                shift 2
                ;;
            --force)
                force=1
                shift
                ;;
            --from-worktree)
                from_worktree=1
                shift
                ;;
            *) die "unknown init/bootstrap flag: $1" ;;
        esac
    done
    [ -n "$profiles_csv" ] || die "init requires --profile a,b — kit profiles: $(basename -a "$KIT_ROOT"/profiles/* | tr '\n' ' ')"
    [ -d .git ] || [ -d .jj ] || die "not a repo root (no .git or .jj here)"
    repo_path_safe .substrate ".substrate vendor directory" || die "unsafe .substrate destination"
    repo_path_safe substrate.json "substrate configuration" || die "unsafe substrate.json destination"
    guard_vendor_downgrade "$force"
    guard_vendor_source "$from_worktree"

    local profiles=(base)
    local requested=() p
    IFS=',' read -r -a requested <<< "$profiles_csv"
    for p in "${requested[@]}"; do
        [ "$p" = "base" ] || profiles+=("$p")
    done

    local profiles_json configured_json fresh=0
    profiles_json=$(printf '%s\n' "${profiles[@]}" | jq -Rn '[inputs]')
    [ -d .substrate ] || fresh=1
    if [ -f substrate.json ]; then
        jq -e '(.profiles | type == "array") and (.profiles | length > 0)' substrate.json >/dev/null 2>&1 \
            || die "substrate.json is corrupt or has no profiles"
        configured_json=$(jq -c '.profiles' substrate.json)
        [ "$configured_json" = "$(jq -c . <<< "$profiles_json")" ] \
            || die "requested profiles differ from substrate.json — edit its profiles list, then run: substrate bootstrap"
        info "substrate.json exists — left untouched"
    else
        seed_config "$profiles_json"
        fresh=1
        success "substrate.json seeded — review the unscanned ledger"
    fi

    if ! install_repo_scaffold "$force" "${profiles[@]}"; then
        warn "repository scaffold INCOMPLETE — fix the warnings above and rerun substrate bootstrap"
        exit 1
    fi
    if [ "${SUBSTRATE_MAINTENANCE_RENDER:-}" = 1 ]; then
        success "repository scaffold candidate rendered"
        return 0
    fi
    local init_rc=0
    sync_repo_runtime || init_rc=1
    sync_user_harness || init_rc=1

    if [ "$init_rc" -ne 0 ]; then
        warn "bootstrap INCOMPLETE — fix the warnings above and rerun substrate bootstrap"
        exit 1
    fi
    if [ "$fresh" -eq 0 ]; then
        success "substrate repository scaffold synchronized"
        return 0
    fi
    cat <<'EOF'

next steps (in order):
  1. substrate doctor                      # toolchain + config sanity
  2. substrate gate                    # first run: expect findings + pending baseline
  3. substrate gate --update-baseline  # grandfather current debt (green infra only)
  4. positive control: add a slop comment to a source file, rerun, MUST go red; revert
  5. substrate selftest                    # full negative battery (includes slop injection)
EOF
}

cmd_bootstrap_apply() {
    local arg has_profile=0 profiles_csv
    repo_path_safe substrate.json "substrate configuration" || die "unsafe substrate.json destination"
    for arg in "$@"; do
        [ "$arg" = "--profile" ] && has_profile=1
    done
    if [ "$has_profile" -eq 1 ]; then
        cmd_init_apply "$@"
        return
    fi
    [ -f substrate.json ] \
        || die "bootstrap requires --profile a,b the first time; later runs read substrate.json"
    jq -e '(.profiles | type == "array") and (.profiles | length > 0)' substrate.json >/dev/null 2>&1 \
        || die "substrate.json is corrupt or has no profiles"
    profiles_csv=$(jq -r '.profiles | join(",")' substrate.json)
    cmd_init_apply --profile "$profiles_csv" "$@"
}

cmd_update_direct() {
    local apply=0 force=0 from_worktree=0 arg
    for arg in "$@"; do
        case "$arg" in
            --apply) apply=1 ;;
            --force) force=1 ;;
            --from-worktree) from_worktree=1 ;;
            *) die "unknown update flag: $arg" ;;
        esac
    done
    repo_path_safe .substrate ".substrate vendor directory" || die "unsafe .substrate destination"
    repo_path_safe substrate.json "substrate configuration" || die "unsafe substrate.json destination"
    [ -d .substrate ] || die "no .substrate here — run: substrate init"
    jq -e . substrate.json >/dev/null 2>&1 || die "substrate.json missing or corrupt"

    local kit_v
    kit_v=$(cat "$KIT_ROOT/VERSION")
    guard_vendor_downgrade "$force"
    guard_vendor_source "$from_worktree"

    local profiles=()
    mapfile -t profiles < <(jq -r '.profiles[]' substrate.json)
    [ ${#profiles[@]} -gt 0 ] || die "substrate.json has no profiles"

    if [ "$apply" -ne 1 ]; then
        local staging
        staging=$(mktemp -d)
        mkdir -p "$staging/repo"
        (cd "$staging/repo" && vendor_core "${profiles[@]}") || { rm -rf "$staging"; die "staging vendor failed"; }
        report_vendor_staleness
        info "diff vendored .substrate vs kit $kit_v (apply with: substrate update --apply):"
        diff -r -x vendor.json .substrate "$staging/repo/.substrate" || true
        rm -rf "$staging"
        return 0
    fi

    vendor_core "${profiles[@]}"
    migrate_repo_omp_extension \
        || die "repo-local omp extension migration failed — resolve the warning and rerun"
    if [ "${SUBSTRATE_MAINTENANCE_RENDER:-}" != 1 ]; then
        sync_user_harness \
            || die "user-level harness refresh failed — rerun after fixing the warning"
    fi
    success "re-vendored .substrate at kit $kit_v (config, baseline, templates untouched)"
}

cmd_init() {
    maintenance_run init "$@"
}

cmd_bootstrap() {
    maintenance_run bootstrap "$@"
}

cmd_update() {
    local arg apply=0
    for arg in "$@"; do
        [ "$arg" != --apply ] || apply=1
    done
    if [ "$apply" -eq 1 ]; then
        maintenance_run update "$@"
    else
        cmd_update_direct "$@"
    fi
}

cmd_gate() {
    command -v substrate-engine >/dev/null 2>&1 || die "substrate-engine not found — run: substrate doctor"
    if [ "${1:-}" = --deep ]; then
        shift
        [ "$#" -le 1 ] || usage
        case "${1:-}" in
            ""|--no-cache|--print-key) ;;
            *) usage ;;
        esac
        [ -x .substrate/gitleaks-deep.sh ] || die "deep scan runtime missing — run: substrate update --apply"
        substrate-engine gate || return
        exec .substrate/gitleaks-deep.sh "$@"
    fi
    exec substrate-engine gate "$@"
}

cmd_engine() {
    case "${1:-}" in
        pin) shift; cmd_engine_pin "$@" ;;
        *) usage ;;
    esac
}

cmd_engine_pin() {
    local bin=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --bin)
                [ $# -ge 2 ] || die "--bin needs a path"
                bin="$2"
                shift 2
                ;;
            *) die "unknown engine pin flag: $1" ;;
        esac
    done
    [ -n "$bin" ] || bin="${SUBSTRATE_ENGINE_BIN:-}"
    if [ -z "$bin" ]; then
        bin=$(command -v substrate-engine 2>/dev/null) \
            || die "no substrate-engine binary found (--bin, SUBSTRATE_ENGINE_BIN, or PATH)"
    fi
    [ -x "$bin" ] || die "engine binary not executable: $bin"
    local pin_json staged
    pin_json=$("$bin" pin emit) || die "engine pin emit failed: $bin pin emit"
    staged=$(mktemp "$KIT_ROOT/engine.json.XXXXXX") || die "engine pin staging failed"
    if printf '%s\n' "$pin_json" > "$staged" && mv -f "$staged" "$KIT_ROOT/engine.json"; then
        success "engine pin written: $KIT_ROOT/engine.json ($pin_json)"
    else
        rm -f "$staged"
        die "engine pin write failed"
    fi
}

if [ "${1:-}" = __maintenance-render ]; then
    shift
    operation="${1:-}"
    shift || true
    case "$operation" in
        init|bootstrap) cmd_init_apply "$@" ;;
        update) cmd_update_direct "$@" ;;
        *) exit 2 ;;
    esac
    exit
fi

case "${1:-}" in

    bootstrap) shift; cmd_bootstrap "$@" ;;
    init)     shift; cmd_init "$@" ;;
    gate)     shift; cmd_gate "$@" ;;
    checkpoint) shift; exec substrate-engine checkpoint "$@" ;;
    restructure) shift; exec substrate-engine restructure "$@" ;;
    baseline)
        shift
        args=()
        [ "$#" -gt 0 ] || args=(--update-baseline)
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --update) args+=(--update-baseline); shift ;;
                --accept-regression|--accept-regression=*) args+=("$1"); shift ;;
                --reason) [ "$#" -ge 2 ] || usage; args+=("--reason=$2"); shift 2 ;;
                *) usage ;;
            esac
        done
        exec substrate-engine gate "${args[@]}" ;;
    doctor)   shift; cmd_doctor "$@" ;;
    verify)   shift; cmd_verify "$@" ;;
    update)   shift; cmd_update "$@" ;;
    engine)   shift; cmd_engine "$@" ;;
    selftest) shift; [ -x .substrate/selftest.sh ] || die "no .substrate here — run: substrate init"; exec .substrate/selftest.sh "$@" ;;
    audit)    shift; [ -x .substrate/audit.sh ] || die "no .substrate here — run: substrate init"; exec .substrate/audit.sh "$@" ;;
    report)   shift; [ -x .substrate/report.sh ] || die "no .substrate here — run: substrate init"; exec .substrate/report.sh "$@" ;;
    *) usage ;;
esac
