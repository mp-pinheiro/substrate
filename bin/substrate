#!/usr/bin/env bash
# substrate — deterministic gates for agentic development, installable in any repo.
# Commands: init, gate, baseline, doctor, update, selftest. See docs/contracts.md.
set -uo pipefail

KIT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

info()    { printf '\033[0;34m[+]\033[0m %s\n' "$*"; }
success() { printf '\033[0;32m[ok]\033[0m %s\n' "$*"; }
warn()    { printf '\033[0;33m[!]\033[0m %s\n' "$*"; }
die()     { warn "$*"; exit 2; }

usage() {
    cat <<'EOF'
usage: substrate <command> [args]

  init --profile a,b [--vcs auto|git|jj]   install the gate into the current repo
  gate [--update-baseline|--accept-regression]
  baseline [--update|--accept-regression]
  doctor                                    config, langmap freshness, toolchain
  update [--apply] [--force]                re-vendor .substrate/ from the kit
  selftest                                  sandboxed negative-test battery
  audit [plan.md ...]                       execute plan acceptance oracles
  report                                    advisory maintenance queue (always exits 0)
EOF
    exit 2
}

profile_dir() {
    local p="$1"
    if [ -d "substrate-profiles/$p" ]; then
        printf '%s\n' "substrate-profiles/$p"
    elif [ -d "$KIT_ROOT/profiles/$p" ]; then
        printf '%s\n' "$KIT_ROOT/profiles/$p"
    else
        return 1
    fi
}

build_langmap() {
    local out="$1"; shift
    local pjsons=() p d
    for p in "$@"; do
        d=$(profile_dir "$p") || die "unknown profile: $p (kit profiles: $(basename -a "$KIT_ROOT"/profiles/* | tr '\n' ' '))"
        jq -e . "$d/profile.json" >/dev/null 2>&1 || die "corrupt profile.json for $p"
        pjsons+=("$d/profile.json")
    done
    jq -s 'reduce .[] as $p ({};
        (reduce ($p.claims | to_entries[]) as $e (.;
            if has($e.key) then error("duplicate claim \($e.key): profiles \(.[$e.key].profile) and \($p.name)")
            else .[$e.key] = ($e.value + {profile: $p.name}) end))
        | .__shebang__ = ((.__shebang__ // []) + [($p.shebang // [])[]
            | {match: .interpreters, entry: ($p.claims[.as] + {profile: $p.name})}]))' \
        "${pjsons[@]}" > "$out" \
        || die "langmap build failed (duplicate claims or corrupt profile.json)"
}

vendor_core() {
    local profiles=("$@") p d c staging=.substrate.new
    rm -rf "$staging"
    mkdir -p "$staging/checks.d" "$staging/hooks" "$staging/profiles"
    cp "$KIT_ROOT"/core/gate.sh "$KIT_ROOT"/core/gate-lib.sh \
       "$KIT_ROOT"/core/check-comments.sh "$KIT_ROOT"/core/comment-ratchet.sh \
       "$KIT_ROOT"/core/selftest.sh "$KIT_ROOT"/core/audit.sh "$staging/" || die "vendor copy failed: core scripts"
    cp "$KIT_ROOT"/core/hooks/*.sh "$staging/hooks/" || die "vendor copy failed: hooks"
    cp "$KIT_ROOT"/core/checks.d/*.sh "$staging/checks.d/" || die "vendor copy failed: core checks"
    cp "$KIT_ROOT"/VERSION "$staging/VERSION" || die "vendor copy failed: VERSION"
    for p in "${profiles[@]}"; do
        d=$(profile_dir "$p") || die "unknown profile: $p"
        cp -R "$d" "$staging/profiles/$p" || die "vendor copy failed: profile $p"
        if [ -d "$d/checks.d" ]; then
            for c in "$d"/checks.d/*.sh; do
                [ -f "$c" ] && { cp "$c" "$staging/checks.d/" || die "vendor copy failed: $c"; }
            done
        fi
    done
    if [ -d checks.d ]; then
        for c in checks.d/*.sh; do
            [ -f "$c" ] && { cp "$c" "$staging/checks.d/" || die "vendor copy failed: repo-local $c"; }
        done
    fi
    build_langmap "$staging/langmap.json" "${profiles[@]}"
    chmod +x "$staging"/*.sh "$staging"/hooks/*.sh "$staging"/checks.d/*.sh
    rm -rf .substrate.old
    if [ -d .substrate ]; then
        mv .substrate .substrate.old || die "vendor swap failed: could not set aside old copy"
    fi
    mv "$staging" .substrate || die "vendor swap failed — previous copy preserved at .substrate.old"
    rm -rf .substrate.old
}

seed_config() {
    local profiles_json="$1"
    jq -n --argjson profiles "$profiles_json" '{
        version: 1,
        profiles: $profiles,
        inventory: "auto",
        unscanned: [
            "*.md", "**/*.md", "*.txt", "*.lock", "*.toml",
            "LICENSE*", "VERSION", ".gitignore", ".gitattributes", ".gitmodules",
            "*.png", "*.svg", "*.jpg", "*.csv", "Dockerfile*", "Makefile", "justfile",
            ".substrate/**", ".omp/extensions/substrate-quality.ts", ".importlinter"
        ],
        protected_paths: [],
        comment: { allow_tags: ["SAFETY:", "WHY:", "PERF:", "HACK:"] },
        budgets: { max_file_lines: 500 },
        duplication: { min_tokens: 35 },
        checks: { disabled: [] },
        push_gate: true
    }' > substrate.json
}

install_ci() {
    local profiles=("$@") p d lines=() l
    [ -f .github/workflows/substrate-gate.yml ] && { info "CI workflow exists — left untouched"; return 0; }
    for p in "${profiles[@]}"; do
        d=$(profile_dir "$p") || continue
        while IFS= read -r l; do
            [ -n "$l" ] && lines+=("$l")
        done < <(jq -r '(.ci // [])[]' "$d/profile.json")
    done
    mkdir -p .github/workflows
    local out=.github/workflows/substrate-gate.yml line trimmed
    : > "$out"
    while IFS= read -r line; do
        trimmed="${line#"${line%%[![:space:]]*}"}"
        if [ "$trimmed" = "# substrate:profile-toolchain" ]; then
            for l in ${lines[@]+"${lines[@]}"}; do
                printf '          %s\n' "$l" >> "$out"
            done
        else
            printf '%s\n' "$line" >> "$out"
        fi
    done < "$KIT_ROOT/core/ci/github-gate.yml"
    success "CI workflow installed: $out"
}

install_hooks_config() {
    local template="$KIT_ROOT/core/claude-hooks.json" settings=.claude/settings.json merged
    mkdir -p .claude
    if [ -f "$settings" ] && jq -e . "$settings" >/dev/null 2>&1; then
        # hook arrays concatenate (deep merge would drop repo-owned hooks) yet
        # stay idempotent: .substrate/ groups are dropped before re-appending
        if ! merged=$(jq --argjson extra "$(cat "$template")" '
            def keep: map(select([.hooks[]?.command // ""] | any(test("\\.substrate/hooks/")) | not));
            .hooks.PreToolUse = (((.hooks.PreToolUse // []) | keep) + ($extra.hooks.PreToolUse // []))
            | .hooks.PostToolUse = (((.hooks.PostToolUse // []) | keep) + ($extra.hooks.PostToolUse // []))
        ' "$settings"); then
            warn "Claude settings merge failed — $settings left untouched"
            return 1
        fi
        if ! printf '%s\n' "$merged" > "$settings" 2>/dev/null; then
            warn "$settings is not writable (locked?) — chmod u+w it, rerun init, or merge manually from $template"
            return 1
        fi
    elif [ -f "$settings" ]; then
        warn "$settings exists but is not valid JSON — left untouched; merge the hooks manually from $template"
        return 1
    else
        cp "$template" "$settings" || { warn "failed to write $settings"; return 1; }
    fi
    success "Claude hooks wired in $settings"
    mkdir -p .omp/extensions
    cp "$KIT_ROOT/core/omp/substrate-quality.ts" .omp/extensions/ || { warn "omp extension install failed"; return 1; }
    success "omp extension installed: .omp/extensions/substrate-quality.ts"
}

install_skills() {
    local s name dest
    [ -d "$KIT_ROOT/skills" ] || return 0
    if ! mkdir -p .claude/skills 2>/dev/null; then
        warn ".claude/skills is not a directory — skills not installed; fix the path and rerun init"
        return 1
    fi
    for s in "$KIT_ROOT"/skills/*/; do
        [ -d "$s" ] || continue
        name=$(basename "$s")
        dest=".claude/skills/$name"
        if [ -e "$dest" ]; then
            info "skill $name exists — left untouched"
        elif cp -R "$s" "$dest" 2>/dev/null; then
            success "skill installed: $dest"
        else
            warn "skill $name install failed — is .claude/skills writable?"
            return 1
        fi
    done
}

install_templates() {
    local profiles=("$@") p d src dest
    for p in "${profiles[@]}"; do
        d=$(profile_dir "$p") || continue
        while IFS=$'\t' read -r src dest; do
            [ -n "$src" ] || continue
            if [ -e "$dest" ]; then
                info "template $dest exists — left untouched"
            else
                mkdir -p "$(dirname "$dest")"
                cp "$d/templates/$src" "$dest"
                success "template installed: $dest"
            fi
        done < <(jq -r '(.templates // [])[] | "\(.src)\t\(.dest)"' "$d/profile.json")
    done
}

install_recipe() {
    if [ -f justfile ]; then
        grep -q '.substrate/gate.sh' justfile || printf '\ngate *ARGS:\n    .substrate/gate.sh {{ARGS}}\n' >> justfile
    elif [ -f Makefile ]; then
        grep -q '.substrate/gate.sh' Makefile || printf '\ngate:\n\t.substrate/gate.sh\n' >> Makefile
    else
        printf 'gate *ARGS:\n    .substrate/gate.sh {{ARGS}}\n' > justfile
    fi
    success "gate recipe wired (just gate)"
}

cmd_init() {
    local profiles_csv=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --profile) profiles_csv="${2:-}"; shift 2 ;;
            --vcs) shift 2 ;;
            *) die "unknown init flag: $1" ;;
        esac
    done
    [ -n "$profiles_csv" ] || die "init requires --profile a,b — kit profiles: $(basename -a "$KIT_ROOT"/profiles/* | tr '\n' ' ')"
    [ -d .git ] || [ -d .jj ] || die "not a repo root (no .git or .jj here)"

    local profiles=(base)
    local requested=() p
    IFS=',' read -r -a requested <<< "$profiles_csv"
    for p in "${requested[@]}"; do
        [ "$p" = "base" ] || profiles+=("$p")
    done

    vendor_core "${profiles[@]}"
    if [ -f substrate.json ]; then
        info "substrate.json exists — left untouched (its profiles list drives update/doctor)"
    else
        seed_config "$(printf '%s\n' "${profiles[@]}" | jq -Rn '[inputs]')"
        success "substrate.json seeded — review the unscanned ledger"
    fi
    local init_rc=0
    install_templates "${profiles[@]}" || init_rc=1
    install_ci "${profiles[@]}" || init_rc=1
    install_hooks_config || init_rc=1
    install_skills || init_rc=1
    install_recipe || init_rc=1

    cat <<'EOF'

next steps (in order):
  1. substrate doctor                      # toolchain + config sanity
  2. .substrate/gate.sh                    # first run: expect findings + pending baseline
  3. .substrate/gate.sh --update-baseline  # grandfather current debt (green infra only)
  4. positive control: add a slop comment to a source file, rerun, MUST go red; revert
  5. substrate selftest                    # full negative battery (includes slop injection)
EOF
    if [ "$init_rc" -ne 0 ]; then
        warn "init INCOMPLETE — fix the warnings above and rerun init (a repo without write-time hooks drifts silently)"
        exit 1
    fi
}

cmd_update() {
    local apply=0 force=0 arg
    for arg in "$@"; do
        case "$arg" in
            --apply) apply=1 ;;
            --force) force=1 ;;
            *) die "unknown update flag: $arg" ;;
        esac
    done
    [ -d .substrate ] || die "no .substrate here — run: substrate init"
    jq -e . substrate.json >/dev/null 2>&1 || die "substrate.json missing or corrupt"

    local kit_v vendored_v newest
    kit_v=$(cat "$KIT_ROOT/VERSION")
    vendored_v=$(cat .substrate/VERSION 2>/dev/null || echo "0.0.0")
    newest=$(printf '%s\n%s\n' "$kit_v" "$vendored_v" | sort -V | tail -1)
    if [ "$newest" != "$kit_v" ] && [ "$force" -ne 1 ]; then
        die "vendored $vendored_v is newer than kit $kit_v — pass --force to downgrade"
    fi

    local profiles=()
    mapfile -t profiles < <(jq -r '.profiles[]' substrate.json)
    [ ${#profiles[@]} -gt 0 ] || die "substrate.json has no profiles"

    if [ "$apply" -ne 1 ]; then
        local staging
        staging=$(mktemp -d)
        mkdir -p "$staging/repo"
        (cd "$staging/repo" && vendor_core "${profiles[@]}") || { rm -rf "$staging"; die "staging vendor failed"; }
        info "diff vendored .substrate vs kit $kit_v (apply with: substrate update --apply):"
        diff -r .substrate "$staging/repo/.substrate" || true
        rm -rf "$staging"
        return 0
    fi

    vendor_core "${profiles[@]}"
    if [ -f .omp/extensions/substrate-quality.ts ]; then
        cp "$KIT_ROOT/core/omp/substrate-quality.ts" .omp/extensions/substrate-quality.ts \
            || die "failed to refresh installed omp extension"
        info "refreshed .omp/extensions/substrate-quality.ts"
    fi
    success "re-vendored .substrate at kit $kit_v (config, baseline, templates untouched)"
}

cmd_doctor() {
    [ -d .substrate ] || die "no .substrate here — run: substrate init"
    jq -e . substrate.json >/dev/null 2>&1 || die "substrate.json missing or corrupt"
    success "substrate.json parses"

    local profiles=()
    mapfile -t profiles < <(jq -r '.profiles[]' substrate.json)
    local fresh
    fresh=$(mktemp)
    build_langmap "$fresh" "${profiles[@]}"
    if cmp -s "$fresh" .substrate/langmap.json; then
        success "langmap fresh"
    else
        warn "langmap stale vs profiles — run: substrate update --apply"
    fi
    rm -f "$fresh"

    local h hb hooks_missing=0
    if [ -f .claude/settings.json ] && jq -e . .claude/settings.json >/dev/null 2>&1; then
        for h in .substrate/hooks/*.sh; do
            [ -f "$h" ] || continue
            hb=$(basename "$h")
            if ! grep -q "$hb" .claude/settings.json; then
                warn "hook $hb not wired in .claude/settings.json — rerun init or merge manually"
                hooks_missing=1
            fi
        done
        [ "$hooks_missing" -eq 0 ] && success "claude hooks wired"
    else
        warn ".claude/settings.json absent or invalid — write-time hooks unarmed (run init)"
    fi
    if [ -f .omp/extensions/substrate-quality.ts ]; then
        success "omp extension installed"
    else
        warn "omp extension absent — the omp harness runs ungated (run init)"
    fi

    local c cb
    for c in checks.d/*.sh; do
        [ -f "$c" ] || continue
        cb=$(basename "$c")
        if [ ! -f ".substrate/checks.d/$cb" ]; then
            warn "repo check $cb not vendored — it does NOT run; run: substrate update --apply"
        elif ! cmp -s "$c" ".substrate/checks.d/$cb"; then
            warn "repo check $cb drifted from its vendored copy — run: substrate update --apply"
        else
            success "repo check $cb vendored and current"
        fi
    done

    local p d bin hint
    for p in "${profiles[@]}"; do
        d=$(profile_dir "$p") || { warn "profile $p not found"; continue; }
        while IFS=$'\t' read -r bin hint; do
            [ -n "$bin" ] || continue
            if command -v "$bin" >/dev/null 2>&1; then
                success "$p: $bin present"
            else
                warn "$p: $bin MISSING — $hint"
            fi
        done < <(jq -r '(.toolchain // [])[] | "\(.bin)\t\(.hint)"' "$d/profile.json")
    done
    for bin in jq ast-grep bunx; do
        if command -v "$bin" >/dev/null 2>&1; then
            success "core: $bin present"
        else
            warn "core: $bin missing (ast-grep falls back to bunx; bunx needs bun)"
        fi
    done
    info "kit $(cat "$KIT_ROOT/VERSION"), vendored $(cat .substrate/VERSION 2>/dev/null || echo none)"
}

report_duplication() {
    printf '\n-- duplication clusters (jscpd --min-tokens 35, worst 10 by lines)\n'
    if ! command -v bunx >/dev/null 2>&1; then
        printf 'skipped: bunx not found (install bun: https://bun.sh)\n'
        return 0
    fi
    local dir
    dir=$(mktemp -d)
    bunx --yes jscpd --min-tokens 35 --reporters json --output "$dir" --silent \
        --ignore "**/.git/**,**/.jj/**,**/.substrate/**,**/node_modules/**" . >/dev/null 2>&1
    if ! jq -e . "$dir/jscpd-report.json" >/dev/null 2>&1; then
        printf 'skipped: jscpd produced no report\n'
        rm -rf "$dir"
        return 0
    fi
    jq -r '"total duplication: \(.statistics.total.percentage // 0)% across \(.statistics.total.clones // 0) clones",
        (.duplicates | sort_by(-.lines) | .[0:10][]
         | "\(.firstFile.name):\(.firstFile.start)-\(.firstFile.end) <-> \(.secondFile.name):\(.secondFile.start)-\(.secondFile.end) — \(.lines) duplicated lines — extract the shared shape")' \
        "$dir/jscpd-report.json"
    rm -rf "$dir"
}

report_dead_code() {
    printf '\n-- dead code candidates\n'
    local pyfiles=() f
    while IFS= read -r f; do
        [ -n "$f" ] && pyfiles+=("$f")
    done < <(git ls-files '*.py' 2>/dev/null)
    if [ ${#pyfiles[@]} -eq 0 ]; then
        printf 'no python files tracked\n'
    elif command -v vulture >/dev/null 2>&1; then
        vulture ${pyfiles[@]+"${pyfiles[@]}"} || true
    else
        printf 'skipped: vulture not found (pipx install vulture) — %s python files unscanned\n' "${#pyfiles[@]}"
    fi
    if [ -f package.json ]; then
        printf 'candidate: knip for dead exports (package.json present; knip is repo-config-dependent, report-only by design)\n'
    fi
}

report_ratchet() {
    printf '\n-- ratchet tightening candidates (baseline metrics, desc)\n'
    if ! jq -e . substrate-baseline.json >/dev/null 2>&1; then
        printf 'skipped: no substrate-baseline.json (run the gate, then --update-baseline)\n'
        return 0
    fi
    jq -r '.metrics | to_entries | sort_by(-.value)[] | "\(.key) = \(.value)"' substrate-baseline.json
    printf 'run the gate: improved metrics print a lock-in hint; tighten with --update-baseline\n'
}

cmd_report() {
    printf '== substrate report: maintenance queue (advisory — never fails)\n'
    report_duplication
    report_dead_code
    report_ratchet
    exit 0
}

case "${1:-}" in
    init)     shift; cmd_init "$@" ;;
    gate)     shift; [ -x .substrate/gate.sh ] || die "no .substrate here — run: substrate init"; exec .substrate/gate.sh "$@" ;;
    baseline)
        shift
        flag="${1:---update}"
        case "$flag" in
            --update) exec .substrate/gate.sh --update-baseline ;;
            --accept-regression) exec .substrate/gate.sh --accept-regression ;;
            *) usage ;;
        esac ;;
    doctor)   shift; cmd_doctor "$@" ;;
    update)   shift; cmd_update "$@" ;;
    selftest) shift; [ -x .substrate/selftest.sh ] || die "no .substrate here — run: substrate init"; exec .substrate/selftest.sh "$@" ;;
    audit)    shift; [ -x .substrate/audit.sh ] || die "no .substrate here — run: substrate init"; exec .substrate/audit.sh "$@" ;;
    report)   shift; cmd_report "$@" ;;
    *) usage ;;
esac
