#!/usr/bin/env bash
# substrate — deterministic gates for agentic development, installable in any repo.
# Commands: bootstrap, init, gate, baseline, doctor, update, selftest. See docs/contracts.md.
set -uo pipefail

KIT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

info()    { printf '\033[0;34m[+]\033[0m %s\n' "$*"; }
success() { printf '\033[0;32m[ok]\033[0m %s\n' "$*"; }
warn()    { printf '\033[0;33m[!]\033[0m %s\n' "$*"; }
die()     { warn "$*"; exit 2; }

usage() {
    cat <<'EOF'
usage: substrate <command> [args]

  bootstrap [--profile a,b] [--force]       kickstart or synchronize the current repo
  init --profile a,b [--vcs auto|git|jj]   install the gate into a new repo
  gate [--update-baseline|--accept-regression]
  baseline [--update|--accept-regression]
  doctor                                    config, langmap freshness, toolchain
  update [--apply] [--force]                inspect or re-vendor the engine only
  selftest                                  sandboxed negative-test battery
  audit [plan.md ...]                       execute plan acceptance oracles
  report                                    advisory maintenance queue (always exits 0)
EOF
    exit 2
}

profile_dir() {
    local p="$1"
    if [ -d "substrate-profiles/$p" ]; then
        printf '%s\n' "substrate-profiles/$p"
    elif [ -d "$KIT_ROOT/profiles/$p" ]; then
        printf '%s\n' "$KIT_ROOT/profiles/$p"
    else
        return 1
    fi
}

# shellcheck source=../core/install-lib.sh
source "$KIT_ROOT/core/install-lib.sh"


build_langmap() {
    local out="$1"; shift
    local pjsons=() p d
    for p in "$@"; do
        d=$(profile_dir "$p") || die "unknown profile: $p (kit profiles: $(basename -a "$KIT_ROOT"/profiles/* | tr '\n' ' '))"
        jq -e . "$d/profile.json" >/dev/null 2>&1 || die "corrupt profile.json for $p"
        pjsons+=("$d/profile.json")
    done
    jq -s 'reduce .[] as $p ({};
        (reduce ($p.claims | to_entries[]) as $e (.;
            if has($e.key) then error("duplicate claim \($e.key): profiles \(.[$e.key].profile) and \($p.name)")
            else .[$e.key] = ($e.value + {profile: $p.name}) end))
        | .__shebang__ = ((.__shebang__ // []) + [($p.shebang // [])[]
            | {match: .interpreters, entry: ($p.claims[.as] + {profile: $p.name})}]))' \
        "${pjsons[@]}" > "$out" \
        || die "langmap build failed (duplicate claims or corrupt profile.json)"
}

vendor_core() {
    local profiles=("$@") p d c staging backup=""
    repo_path_safe .substrate ".substrate vendor directory" || die "unsafe .substrate destination"
    [ ! -e .substrate ] || [ -d .substrate ] || die ".substrate exists but is not a directory"
    staging=$(mktemp -d .substrate.new.XXXXXX) || die "vendor staging failed"
    mkdir -p "$staging/checks.d" "$staging/hooks" "$staging/profiles"
    cp "$KIT_ROOT"/core/gate.sh "$KIT_ROOT"/core/gate-lib.sh \
       "$KIT_ROOT"/core/check-comments.sh "$KIT_ROOT"/core/comment-ratchet.sh \
       "$KIT_ROOT"/core/selftest.sh "$KIT_ROOT"/core/audit.sh \
       "$KIT_ROOT"/core/report.sh "$KIT_ROOT"/core/gated-push.sh "$staging/" || die "vendor copy failed: core scripts"
    cp "$KIT_ROOT"/core/hooks/*.sh "$staging/hooks/" || die "vendor copy failed: hooks"
    cp "$KIT_ROOT"/core/checks.d/*.sh "$staging/checks.d/" || die "vendor copy failed: core checks"
    cp "$KIT_ROOT"/VERSION "$staging/VERSION" || die "vendor copy failed: VERSION"
    for p in "${profiles[@]}"; do
        d=$(profile_dir "$p") || die "unknown profile: $p"
        cp -R "$d" "$staging/profiles/$p" || die "vendor copy failed: profile $p"
        if [ -d "$d/checks.d" ]; then
            for c in "$d"/checks.d/*.sh; do
                [ -f "$c" ] && { cp "$c" "$staging/checks.d/" || die "vendor copy failed: $c"; }
            done
        fi
    done
    if [ -d checks.d ]; then
        for c in checks.d/*.sh; do
            [ -f "$c" ] && { cp "$c" "$staging/checks.d/" || die "vendor copy failed: repo-local $c"; }
        done
    fi
    build_langmap "$staging/langmap.json" "${profiles[@]}"
    chmod +x "$staging"/*.sh "$staging"/hooks/*.sh "$staging"/checks.d/*.sh
    if [ -d .substrate ]; then
        backup=$(mktemp -d .substrate.backup.XXXXXX) || die "vendor backup failed"
        rm -rf "$backup"
        mv .substrate "$backup" || die "vendor swap failed: could not set aside old copy"
    fi
    if ! mv "$staging" .substrate; then
        if [ -n "$backup" ] && ! mv "$backup" .substrate 2>/dev/null; then
            die "vendor swap and restore failed — recover the previous copy from $backup"
        fi
        die "vendor swap failed — previous copy restored"
    fi
    [ -z "$backup" ] || rm -rf "$backup"
}



cmd_init() {
    local profiles_csv="" force=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --profile)
                [ $# -ge 2 ] || die "--profile needs a comma-separated value"
                profiles_csv="$2"
                shift 2
                ;;
            --vcs)
                [ $# -ge 2 ] || die "--vcs needs auto, git, or jj"
                shift 2
                ;;
            --force)
                force=1
                shift
                ;;
            *) die "unknown init/bootstrap flag: $1" ;;
        esac
    done
    [ -n "$profiles_csv" ] || die "init requires --profile a,b — kit profiles: $(basename -a "$KIT_ROOT"/profiles/* | tr '\n' ' ')"
    [ -d .git ] || [ -d .jj ] || die "not a repo root (no .git or .jj here)"
    repo_path_safe .substrate ".substrate vendor directory" || die "unsafe .substrate destination"
    repo_path_safe substrate.json "substrate configuration" || die "unsafe substrate.json destination"
    guard_vendor_downgrade "$force"

    local profiles=(base)
    local requested=() p
    IFS=',' read -r -a requested <<< "$profiles_csv"
    for p in "${requested[@]}"; do
        [ "$p" = "base" ] || profiles+=("$p")
    done

    local profiles_json configured_json fresh=0
    profiles_json=$(printf '%s\n' "${profiles[@]}" | jq -Rn '[inputs]')
    [ -d .substrate ] || fresh=1
    if [ -f substrate.json ]; then
        jq -e '(.profiles | type == "array") and (.profiles | length > 0)' substrate.json >/dev/null 2>&1 \
            || die "substrate.json is corrupt or has no profiles"
        configured_json=$(jq -c '.profiles' substrate.json)
        [ "$configured_json" = "$(jq -c . <<< "$profiles_json")" ] \
            || die "requested profiles differ from substrate.json — edit its profiles list, then run: substrate bootstrap"
        info "substrate.json exists — left untouched"
    else
        seed_config "$profiles_json"
        fresh=1
        success "substrate.json seeded — review the unscanned ledger"
    fi

    vendor_core "${profiles[@]}"
    local init_rc=0
    install_templates "${profiles[@]}" || init_rc=1
    install_ci "$force" "${profiles[@]}" || init_rc=1
    install_hooks_config || init_rc=1
    install_user_harness || init_rc=1
    install_vcs_hooks || init_rc=1
    install_lsp_config "${profiles[@]}" || init_rc=1
    install_harness_assets || init_rc=1
    install_recipe || init_rc=1
    wire_jj || init_rc=1

    if [ "$init_rc" -ne 0 ]; then
        warn "bootstrap INCOMPLETE — fix the warnings above and rerun substrate bootstrap"
        exit 1
    fi
    if [ "$fresh" -eq 0 ]; then
        success "substrate repository scaffold synchronized"
        return 0
    fi
    cat <<'EOF'

next steps (in order):
  1. substrate doctor                      # toolchain + config sanity
  2. .substrate/gate.sh                    # first run: expect findings + pending baseline
  3. .substrate/gate.sh --update-baseline  # grandfather current debt (green infra only)
  4. positive control: add a slop comment to a source file, rerun, MUST go red; revert
  5. substrate selftest                    # full negative battery (includes slop injection)
EOF
}

cmd_bootstrap() {
    local arg has_profile=0 profiles_csv
    repo_path_safe substrate.json "substrate configuration" || die "unsafe substrate.json destination"
    for arg in "$@"; do
        [ "$arg" = "--profile" ] && has_profile=1
    done
    if [ "$has_profile" -eq 1 ]; then
        cmd_init "$@"
        return
    fi
    [ -f substrate.json ] \
        || die "bootstrap requires --profile a,b the first time; later runs read substrate.json"
    jq -e '(.profiles | type == "array") and (.profiles | length > 0)' substrate.json >/dev/null 2>&1 \
        || die "substrate.json is corrupt or has no profiles"
    profiles_csv=$(jq -r '.profiles | join(",")' substrate.json)
    cmd_init --profile "$profiles_csv" "$@"
}

cmd_update() {
    local apply=0 force=0 arg
    for arg in "$@"; do
        case "$arg" in
            --apply) apply=1 ;;
            --force) force=1 ;;
            *) die "unknown update flag: $arg" ;;
        esac
    done
    repo_path_safe .substrate ".substrate vendor directory" || die "unsafe .substrate destination"
    repo_path_safe substrate.json "substrate configuration" || die "unsafe substrate.json destination"
    [ -d .substrate ] || die "no .substrate here — run: substrate init"
    jq -e . substrate.json >/dev/null 2>&1 || die "substrate.json missing or corrupt"

    local kit_v
    kit_v=$(cat "$KIT_ROOT/VERSION")
    guard_vendor_downgrade "$force"

    local profiles=()
    mapfile -t profiles < <(jq -r '.profiles[]' substrate.json)
    [ ${#profiles[@]} -gt 0 ] || die "substrate.json has no profiles"

    if [ "$apply" -ne 1 ]; then
        local staging
        staging=$(mktemp -d)
        mkdir -p "$staging/repo"
        (cd "$staging/repo" && vendor_core "${profiles[@]}") || { rm -rf "$staging"; die "staging vendor failed"; }
        info "diff vendored .substrate vs kit $kit_v (apply with: substrate update --apply):"
        diff -r .substrate "$staging/repo/.substrate" || true
        rm -rf "$staging"
        return 0
    fi

    vendor_core "${profiles[@]}"
    if [ -f .omp/extensions/substrate-quality.ts ]; then
        repo_path_safe .omp/extensions/substrate-quality.ts "omp extension" \
            || die "unsafe omp extension destination"
        cp "$KIT_ROOT/core/omp/substrate-quality.ts" .omp/extensions/substrate-quality.ts \
            || die "failed to refresh installed omp extension"
        info "refreshed .omp/extensions/substrate-quality.ts"
    fi
    install_user_harness \
        || die "user-level harness refresh failed — rerun after fixing the warning"
    success "re-vendored .substrate at kit $kit_v (config, baseline, templates untouched)"
}

cmd_doctor() {
    [ -d .substrate ] || die "no .substrate here — run: substrate init"
    jq -e . substrate.json >/dev/null 2>&1 || die "substrate.json missing or corrupt"
    success "substrate.json parses"

    local profiles=()
    mapfile -t profiles < <(jq -r '.profiles[]' substrate.json)
    local fresh
    fresh=$(mktemp)
    build_langmap "$fresh" "${profiles[@]}"
    if cmp -s "$fresh" .substrate/langmap.json; then
        success "langmap fresh"
    else
        warn "langmap stale vs profiles — run: substrate update --apply"
    fi
    rm -f "$fresh"

    local event matcher command hooks_missing=0
    if [ -f .claude/settings.json ] && jq -e . .claude/settings.json >/dev/null 2>&1; then
        while IFS=$'\t' read -r event matcher command; do
            [ -n "$command" ] || continue
            if ! jq -e --arg event "$event" --arg matcher "$matcher" --arg command "$command" '
                [.hooks[$event][]?
                    | select(.matcher == $matcher)
                    | .hooks[]?
                    | select((.type == "command") and (.command == $command))]
                | length > 0
            ' .claude/settings.json >/dev/null 2>&1; then
                warn "$event hook registration missing or malformed: $command"
                hooks_missing=1
            fi
        done < <(jq -r '
            .hooks | to_entries[] | .key as $event | .value[]
            | .matcher as $matcher | .hooks[]
            | [$event, $matcher, .command] | @tsv
        ' "$KIT_ROOT/core/claude-hooks.json")
        [ "$hooks_missing" -eq 0 ] && success "claude hooks wired"
    else
        warn ".claude/settings.json absent or invalid — write-time hooks unarmed (run init)"
    fi
    if [ -f .omp/extensions/substrate-quality.ts ]; then
        success "omp extension installed"
    else
        warn "omp extension absent — the omp harness runs ungated (run init)"
    fi
    if [ -f "$HOME/.omp/agent/extensions/substrate-quality.ts" ]; then
        if cmp -s "$HOME/.omp/agent/extensions/substrate-quality.ts" "$KIT_ROOT/core/omp/substrate-quality.ts"; then
            success "user-level omp extension current"
        else
            warn "user-level omp extension stale — run: substrate init"
        fi
    else
        warn "no user-level omp extension — sessions rooted outside this repo are unguarded"
    fi
    info "harness hooks arm at session start — restart your agent after init/update"

    local key lbin lhint p d
    for p in "${profiles[@]}"; do
        d=$(profile_dir "$p") || continue
        while IFS=$'\t' read -r key lbin lhint; do
            [ -n "$key" ] || continue
            if command -v "$lbin" >/dev/null 2>&1; then
                success "lsp $key: $lbin present"
            else
                info "lsp $key: $lbin absent — inline diagnostics unavailable; install: $lhint"
            fi
        done < <(jq -r '(.lsp // {}) | to_entries[] | "\(.key)\t\(.value.bin)\t\(.value.hint)"' "$d/profile.json")
    done

    local c cb
    for c in checks.d/*.sh; do
        [ -f "$c" ] || continue
        cb=$(basename "$c")
        if [ ! -f ".substrate/checks.d/$cb" ]; then
            warn "repo check $cb not vendored — it does NOT run; run: substrate update --apply"
        elif ! cmp -s "$c" ".substrate/checks.d/$cb"; then
            warn "repo check $cb drifted from its vendored copy — run: substrate update --apply"
        else
            success "repo check $cb vendored and current"
        fi
    done

    if [ -d .jj ]; then
        if jj config get experimental-advance-branches.enabled-branches >/dev/null 2>&1; then
            success "jj trunk auto-advance configured"
        else
            warn "jj repo without auto-advance — machine-local config; run: substrate init (wire_jj) per clone"
        fi
        if grep -q 'enforce-jj.sh' .claude/settings.json 2>/dev/null; then
            success "jj workflow hooks wired"
        else
            warn "jj repo but enforce-jj not in .claude/settings.json — rerun init"
        fi
        [ -f docs/jj-workflow.md ] || warn "docs/jj-workflow.md missing — rerun init"
    fi

    local p d bin hint
    for p in "${profiles[@]}"; do
        d=$(profile_dir "$p") || { warn "profile $p not found"; continue; }
        while IFS=$'\t' read -r bin hint; do
            [ -n "$bin" ] || continue
            if command -v "$bin" >/dev/null 2>&1; then
                success "$p: $bin present"
            else
                warn "$p: $bin MISSING — $hint"
            fi
        done < <(jq -r '(.toolchain // [])[] | "\(.bin)\t\(.hint)"' "$d/profile.json")
    done
    for bin in jq ast-grep bunx; do
        if command -v "$bin" >/dev/null 2>&1; then
            success "core: $bin present"
        else
            warn "core: $bin missing (ast-grep falls back to bunx; bunx needs bun)"
        fi
    done
    local pkg
    for bin in ast-grep jscpd; do
        case "$bin" in
            ast-grep) pkg="@ast-grep/cli" ;;
            *) pkg="$bin" ;;
        esac
        if command -v "$bin" >/dev/null 2>&1; then
            success "$bin: local binary (offline-safe)"
        else
            warn "$bin: bunx fallback — gate fetches from npm on a cold cache (breaks offline); install with: bun install -g $pkg"
        fi
    done
    info "kit $(cat "$KIT_ROOT/VERSION"), vendored $(cat .substrate/VERSION 2>/dev/null || echo none)"
}
case "${1:-}" in
    bootstrap) shift; cmd_bootstrap "$@" ;;
    init)     shift; cmd_init "$@" ;;
    gate)     shift; [ -x .substrate/gate.sh ] || die "no .substrate here — run: substrate init"; exec .substrate/gate.sh "$@" ;;
    baseline)
        shift
        flag="${1:---update}"
        case "$flag" in
            --update) exec .substrate/gate.sh --update-baseline ;;
            --accept-regression) exec .substrate/gate.sh --accept-regression ;;
            *) usage ;;
        esac ;;
    doctor)   shift; cmd_doctor "$@" ;;
    update)   shift; cmd_update "$@" ;;
    selftest) shift; [ -x .substrate/selftest.sh ] || die "no .substrate here — run: substrate init"; exec .substrate/selftest.sh "$@" ;;
    audit)    shift; [ -x .substrate/audit.sh ] || die "no .substrate here — run: substrate init"; exec .substrate/audit.sh "$@" ;;
    report)   shift; [ -x .substrate/report.sh ] || die "no .substrate here — run: substrate init"; exec .substrate/report.sh "$@" ;;
    *) usage ;;
esac
