{
  "version": 1,
  "profiles": [
    "base",
    "kit-ts",
    "python",
    "shell"
  ],
  "inventory": "auto",
  "unscanned": [
    "**/*.md",
    "*.csv",
    "*.jpg",
    "*.lock",
    "*.md",
    "*.png",
    "*.svg",
    "*.toml",
    "*.txt",
    ".claude/settings.json",
    ".gitattributes",
    ".gitignore",
    ".gitmodules",
    ".github/CODEOWNERS",
    ".importlinter",
    ".omp/**",
    ".substrate/**",
    "Dockerfile*",
    "LICENSE*",
    "Makefile",
    "VERSION",
    "justfile",
    "profiles/*/fixtures/**",
    "profiles/*/templates/**",
    "substrate-profiles/*/fixtures/**",
    "substrate-profiles/*/templates/**"
  ],
  "protected_paths": [
    ".env*",
    "**/.env*",
    "*.key",
    "**/*.key",
    "*.p12",
    "**/*.p12",
    "*.pem",
    "**/*.pem",
    "*.pfx",
    "**/*.pfx",
    "secrets/**",
    "**/secrets/**"
  ],
  "comment": {
    "allow_tags": [
      "SAFETY:",
      "WHY:",
      "PERF:",
      "HACK:"
    ]
  },
  "budgets": {
    "max_file_lines": 500
  },
  "duplication": {
    "min_tokens": 35
  },
  "checks": {
    "disabled": []
  },
  "push_gate": true
}
