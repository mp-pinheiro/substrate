{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/substrate-launch.sh\" protect-paths.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/substrate-launch.sh\" enforce-jj.sh"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/substrate-launch.sh\" enforce-conventional-commits.sh"
          },
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/substrate-launch.sh\" gate-before-push.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/substrate-launch.sh\" changed-files-scan.sh"
          }
        ]
      }
    ]
  }
}
