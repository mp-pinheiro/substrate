# sourced by the zsh dotenv plugin on cd — pins gh to the secondary account for
# this repo only; the machine-global active account stays mp-pinheiro.
# GH_TOKEN outranks the hosts.yml active user for gh, and the repo-local git
# credential helper serves it for pushes. Never commit this file.
# scrubbed subshell: a parent GH_TOKEN must not decide which token is read;
# fail LOUDLY on empty — a silent fallback pushes as the wrong account.
_t="$(unset GH_TOKEN GITHUB_TOKEN; gh auth token -u secondary-user 2>/dev/null)"
if [ -n "$_t" ]; then
    export GH_TOKEN="$_t"
else
    print -u2 "substrate/.env: no secondary-user token — gh would use the ACTIVE account; fix with: gh auth login -u secondary-user"
fi
unset _t

# self-heal the repo credential helper (untracked .git/config, lost on clone):
# empty first entry resets the global chain (credential-manager-win injects the
# wrong username); then a pure-env helper — no gh call, so the active-account
# flip gh's store callback causes can never happen here.
if ! git config --local --get-all credential.helper 2>/dev/null | grep -q x-access-token; then
    git config --local --unset-all credential.helper 2>/dev/null
    git config --local --add credential.helper ''
    git config --local --add credential.helper '!f() { test "$1" = get && printf "username=x-access-token\npassword=%s\n" "$GH_TOKEN"; }; f'
    git config --local credential.useHttpPath false
fi
